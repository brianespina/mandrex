---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingModal from '../components/BookingModal.astro';

export interface Props {
  title: string;
  description: string;
  /** Per-page social preview. Defaults to the site-wide card. */
  image?: string;
}
const { title, description, image = '/assets/mandrex-og.jpg' } = Astro.props;

// Social scrapers require absolute URLs, and canonical tags must be absolute.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/assets/mandrex-logo.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/karla-latin-var.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Mandrex VA Services" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Mandrex VA Services — helping businesses stay organized, productive, and ready to grow" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <BookingModal />
</body>
</html>

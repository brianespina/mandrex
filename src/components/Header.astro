---
import Icon from './Icon.astro';
import { nav, services } from '../data/site.ts';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const isHome = path === '/';
---
<header class={`site-header${isHome ? ' site-header--home' : ''}`}>
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Mandrex Virtual Assistance Services">
      <img src="/assets/mandrex-logo-white.png" alt="Mandrex Virtual Assistance Services" width="170" height="40" />
    </a>

    <button type="button" class="burger" aria-label="Menu" aria-expanded="false" data-burger>
      <span class="burger__icon burger__icon--open"><Icon name="menu" size={20} /></span>
      <span class="burger__icon burger__icon--close"><Icon name="close" size={20} /></span>
    </button>

    <nav class="site-nav" data-nav>
      <a href="/" class={`site-nav__link${isActive('/') ? ' is-active' : ''}`}>Home</a>

      <div class="site-nav__menu" data-menu>
        <a href="/services" class={`site-nav__link site-nav__link--with-chev${isActive('/services') ? ' is-active' : ''}`}>
          Services
          <Icon name="chevron" size={10} stroke="#F6D548" />
        </a>
        <div class="services-dropdown" data-dropdown>
          {services.map((s) => (
            <a href={'/' + s.slug} class="services-dropdown__item">
              <span class="services-dropdown__icon">
                <Icon name={s.key} size={21} />
              </span>
              <span>
                <span class="services-dropdown__title">{s.name}</span>
                <span class="services-dropdown__desc">{s.short}</span>
              </span>
            </a>
          ))}
          <a href="/services" class="services-dropdown__all">View all services →</a>
        </div>
      </div>

      <a href="/about" class={`site-nav__link${isActive('/about') ? ' is-active' : ''}`}>About</a>
      <a href="/testimonials" class={`site-nav__link${isActive('/testimonials') ? ' is-active' : ''}`}>Testimonials</a>
      <a href="/contact" class="btn btn--yellow btn-sm site-nav__cta">Let's talk</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--c-dark);
  }
  .site-header--home {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  .site-header__inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 var(--pad);
    height: 92px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .site-header__logo img {
    height: 40px;
    width: auto;
    display: block;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .site-nav__link {
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 7px;
    transition: color .18s ease;
  }
  .site-nav__link:hover { color: var(--c-yellow); }
  .site-nav__link.is-active { color: var(--c-yellow); }
  .site-nav__cta { height: 48px; }

  .site-nav__menu { position: relative; height: 92px; display: flex; align-items: center; }

  .services-dropdown {
    position: absolute;
    top: 80px;
    left: -30px;
    width: 390px;
    background: #fff;
    border-top: 4px solid var(--c-yellow);
    box-shadow: 0 34px 70px -28px rgba(0, 0, 0, 0.5);
    padding: 12px;
    z-index: 70;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
  }
  .site-nav__menu:hover .services-dropdown,
  .services-dropdown[data-open="true"] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .services-dropdown__item {
    display: flex;
    gap: 15px;
    padding: 15px;
    align-items: center;
    color: var(--c-dark);
    transition: background .18s ease;
  }
  .services-dropdown__item:hover { background: var(--c-tint); color: var(--c-dark); }
  .services-dropdown__icon {
    width: 44px;
    height: 44px;
    flex: none;
    background: var(--c-dark);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .services-dropdown__title {
    display: block;
    font-family: var(--f-head);
    font-size: 15.5px;
    font-weight: 700;
    color: var(--c-dark);
  }
  .services-dropdown__desc {
    display: block;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--c-muted-2);
    margin-top: 2px;
  }
  .services-dropdown__all {
    display: block;
    margin-top: 6px;
    padding: 15px;
    background: var(--c-dark);
    color: #fff;
    font-family: var(--f-head);
    font-size: 14.5px;
    font-weight: 700;
    text-align: center;
    transition: background .18s ease;
  }
  .services-dropdown__all:hover { background: var(--c-green); color: #fff; }

  .burger {
    display: none;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    cursor: pointer;
    padding: 0;
    position: relative;
  }
  .burger__icon { position: absolute; }
  .burger[data-open="true"] .burger__icon--open { display: none; }
  .burger:not([data-open="true"]) .burger__icon--close { display: none; }

  @media (max-width: 880px) {
    .site-header__inner { height: 74px; }
    .burger { display: inline-flex; }
    .site-nav {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--c-dark);
      padding: 6px 22px 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.55);
      z-index: 80;
      display: none;
    }
    .site-nav[data-open="true"] { display: flex; }
    .site-nav__link,
    .site-nav__menu {
      padding: 17px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      height: auto;
    }
    .site-nav__link { font-size: 17px; }
    .site-nav__menu { display: flex; flex-direction: column; align-items: stretch; }
    .site-nav__link--with-chev svg { display: none; }
    .services-dropdown {
      position: static;
      width: 100%;
      box-shadow: none;
      border: none;
      padding: 0;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
    }
    .services-dropdown[data-open="true"] { display: block; }
    .site-nav__cta {
      height: 54px;
      margin-top: 16px;
      padding: 0;
      justify-content: center;
      border-bottom: none;
    }
  }
</style>

<script>
  const burger = document.querySelector('[data-burger]') as HTMLButtonElement | null;
  const nav = document.querySelector('[data-nav]') as HTMLElement | null;
  const menu = document.querySelector('[data-menu]') as HTMLElement | null;
  const dropdown = document.querySelector('[data-dropdown]') as HTMLElement | null;

  burger?.addEventListener('click', () => {
    const open = nav?.getAttribute('data-open') === 'true';
    nav?.setAttribute('data-open', open ? 'false' : 'true');
    burger.setAttribute('data-open', open ? 'false' : 'true');
    burger.setAttribute('aria-expanded', open ? 'false' : 'true');
    if (open && dropdown) dropdown.setAttribute('data-open', 'false');
  });

  // desktop hover handled by CSS; mobile tap toggles dropdown
  const isMobile = () => window.matchMedia('(max-width: 880px)').matches;
  menu?.querySelector('.site-nav__link--with-chev')?.addEventListener('click', (e) => {
    if (!isMobile()) return;
    e.preventDefault();
    const open = dropdown?.getAttribute('data-open') === 'true';
    dropdown?.setAttribute('data-open', open ? 'false' : 'true');
  });

  // close mobile nav when a link inside is clicked
  nav?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      if (!isMobile()) return;
      nav.setAttribute('data-open', 'false');
      burger?.setAttribute('data-open', 'false');
      if (dropdown) dropdown.setAttribute('data-open', 'false');
    });
  });
</script>

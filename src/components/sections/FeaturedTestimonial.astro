---
export interface Props {
  section: {
    quote: string;
    authorInitials?: string;
    authorName: string;
    authorRole?: string;
    stats?: { value: string; label: string }[];
  };
}

const { section } = Astro.props;
---
<section class="container section-featured">
  <div class="featured">
    <div class="stripes featured__bg"></div>
    <div class="featured__grid split">
      <div>
        <div class="featured__mark">"</div>
        <blockquote class="featured__quote">{section.quote}</blockquote>
        <div class="featured__author">
          <div class="featured__avatar">{section.authorInitials}</div>
          <div>
            <div class="featured__name">{section.authorName}</div>
            <div class="featured__role">{section.authorRole}</div>
          </div>
        </div>
      </div>
      {section.stats && section.stats.length > 0 && (
        <div class="featured__stats">
          {section.stats.map((s) => (
            <div class="featured__stat">
              <div class="featured__stat-value">{s.value}</div>
              <div class="featured__stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .section-featured { padding-top: 100px; }
  .featured {
    --featured-pad: clamp(30px, 4.6vw, 64px);
    position: relative;
    overflow: hidden;
    background: var(--c-dark);
    padding-block: var(--featured-pad);
    padding-left: var(--featured-pad);
  }
  /* the stats column bleeds right only while it sits beside the quote; once
     .split (global) stacks them at 1024px the content needs even padding */
  @media (max-width: 1024px) {
    .featured { padding-right: var(--featured-pad); }
  }
  .featured__bg { position: absolute; inset: 0; }
  .featured__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 64px;
    align-items: center;
  }
  .featured__mark {
    font-family: var(--f-head);
    font-size: 72px;
    line-height: 0.6;
    font-weight: 800;
    color: var(--c-yellow);
  }
  .featured__quote {
    margin: 20px 0 30px;
    font-family: var(--f-head);
    font-size: clamp(21px, 2.4vw, 33px);
    line-height: 1.26;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: #fff;
  }
  .featured__author {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .featured__avatar {
    width: 48px;
    height: 48px;
    background: var(--c-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 800;
    color: var(--c-dark);
  }
  .featured__name {
    font-family: var(--f-head);
    font-size: 15.5px;
    font-weight: 700;
    color: #fff;
  }
  .featured__role {
    font-size: 14px;
    color: var(--on-dark-mute);
    margin-top: 2px;
  }
  .featured__stats {
    display: grid;
    gap: 1px;
    background: rgba(255, 255, 255, 0.16);
  }
  .featured__stat {
    background: var(--c-dark);
    padding: 0 0 26px;
  }
  .featured__stat:nth-child(2) { padding: 26px 0 0; }
  .featured__stat-value {
    font-family: var(--f-head);
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: #fff;
    line-height: 1;
  }
  .featured__stat-label {
    font-size: 15px;
    line-height: 1.5;
    color: #9EAB9F;
    margin-top: 8px;
  }
</style>

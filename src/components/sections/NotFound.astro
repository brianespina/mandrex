---
import Icon from '../Icon.astro';
import { getImageSrc } from '../../lib/keystatic.ts';

export interface Props {
  section: {
    backgroundImage?: string | { src: string };
    backgroundPosition?: string;
    eyebrow?: string;
    title: string;
    lead?: string;
    primaryButton?: { label: string; href: string; variant: string };
    secondaryButton?: { label: string; href: string; variant: string };
    navLinks?: { label: string; href: string }[];
  };
}

const { section } = Astro.props;
const imgSrc = getImageSrc(section.backgroundImage);

const btnClass = (variant?: string) => {
  switch (variant) {
    case 'outline-light': return 'btn btn--outline-light btn-lg';
    case 'outline-dark': return 'btn btn--outline-dark btn-lg';
    case 'dark': return 'btn btn--dark btn-lg';
    default: return 'btn btn--yellow btn-lg';
  }
};
---
<section class="notfound">
  <img src={imgSrc} alt="" class="notfound__img" aria-hidden="true" style={`object-position:${section.backgroundPosition || '50% 50%'}`} />
  <div class="scrim"></div>
  <div class="container notfound__content">
    <div class="eyebrow">
      <span class="eyebrow__rule eyebrow__rule--yellow eyebrow__rule--lg"></span>
      <span class="eyebrow__label eyebrow__label--yellow eyebrow__label--lg">{section.eyebrow}</span>
    </div>
    <h1 class="notfound__title">{section.title}</h1>
    {section.lead && <p class="notfound__lead">{section.lead}</p>}
    <div class="notfound__ctas">
      {section.primaryButton && (
        <a href={section.primaryButton.href} class={btnClass(section.primaryButton.variant)}>
          {section.primaryButton.label}
          <Icon name="arrow" size={18} />
        </a>
      )}
      {section.secondaryButton && (
        <a href={section.secondaryButton.href} class={btnClass(section.secondaryButton.variant)}>{section.secondaryButton.label}</a>
      )}
    </div>
    {section.navLinks && section.navLinks.length > 0 && (
      <nav class="notfound__nav">
        {section.navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    )}
  </div>
</section>

<style>
  .notfound {
    position: relative;
    overflow: hidden;
    background: var(--c-dark-2);
    min-height: 100vh;
    display: flex;
    align-items: center;
  }
  .notfound__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .notfound__content {
    position: relative;
    padding: 120px var(--pad);
  }
  .notfound__title {
    margin: 0 0 24px;
    font-size: clamp(34px, 5vw, 68px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    max-width: 760px;
  }
  .notfound__lead {
    margin: 0 0 40px;
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.56;
    color: #C4CFC5;
    max-width: 560px;
  }
  .notfound__ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }
  .notfound__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    max-width: 560px;
  }
  .notfound__nav a {
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    transition: color .18s ease;
  }
  .notfound__nav a:hover { color: var(--c-yellow); }
</style>

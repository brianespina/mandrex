---
export interface Props {
  section: {
    stats: { value: string; label: string; accent?: boolean }[];
  };
}

const { section } = Astro.props;
---
<section class="container section">
  <div class="stats-bar">
    {section.stats.map((s) => (
      <div class={`stats-bar__item${s.accent ? ' stats-bar__item--accent' : ''}`}>
        <div class="stats-bar__value">{s.value}</div>
        <div class="stats-bar__label">{s.label}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .stats-bar__item {
    background: #fff;
    padding: 32px;
  }
  .stats-bar__item--accent { background: var(--c-yellow); }
  .stats-bar__value {
    font-family: var(--f-head);
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--c-green);
    line-height: 1;
  }
  .stats-bar__item--accent .stats-bar__value { color: var(--c-dark); }
  .stats-bar__label {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--c-muted-2);
  }
</style>

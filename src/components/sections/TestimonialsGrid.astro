---
import Icon from '../Icon.astro';
import { getAllTestimonials } from '../../lib/keystatic.ts';

export interface Props {
  section: {
    ctaTitle?: string;
    ctaDescription?: string;
    ctaButton?: { label: string; href: string; variant: string };
  };
}

const { section } = Astro.props;
const testimonials = await getAllTestimonials();
---
<section class="container section-grid">
  <div class="t-grid">
    {testimonials.map((t) => (
      <div class="t-card">
        <div class="t-card__tag">
          <span class="t-card__rule"></span>
          <span>{t.entry.service}</span>
        </div>
        <p class="t-card__quote">{t.entry.quote}</p>
        <div class="t-card__role">{t.entry.role}</div>
        <div class="t-card__detail">{t.entry.detail}</div>
      </div>
    ))}
    <div class="t-card t-card--cta">
      <h3>{section.ctaTitle}</h3>
      <p>{section.ctaDescription}</p>
      {section.ctaButton && (
        <a href={section.ctaButton.href} class="btn btn--dark btn-md">
          {section.ctaButton.label}
          <Icon name="arrow" size={16} />
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .section-grid { padding-top: 16px; }
  .t-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-top: none;
  }
  @media (max-width: 900px) {
    .t-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .t-grid { grid-template-columns: 1fr; }
  }
  .t-card {
    background: #fff;
    padding: 40px;
  }
  .t-card__tag {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }
  .t-card__rule {
    display: block;
    width: 26px;
    height: 3px;
    background: var(--c-green);
  }
  .t-card__tag span {
    font-family: var(--f-head);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-green);
  }
  .t-card__quote {
    margin: 0 0 26px;
    font-size: 17px;
    line-height: 1.62;
    color: var(--c-text);
  }
  .t-card__role {
    font-family: var(--f-head);
    font-size: 14.5px;
    font-weight: 700;
    color: var(--c-dark);
  }
  .t-card__detail {
    font-size: 14px;
    color: var(--c-muted-3);
    margin-top: 3px;
  }
  .t-card--cta {
    background: var(--c-yellow);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .t-card--cta h3 {
    margin: 0 0 12px;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--c-dark);
  }
  .t-card--cta p {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 1.6;
    color: #4A3E0C;
  }
  .t-card--cta .btn { align-self: flex-start; }
</style>

---
import Icon from '../Icon.astro';
import { getAllServices, getImageSrc, getServiceUrl } from '../../lib/keystatic.ts';

export interface Props {
  section: {
    eyebrow?: string;
    title: string;
    showAllButton?: { label: string; href: string; variant: string };
  };
}

const { section } = Astro.props;
const services = await getAllServices();
---
<section class="container section">
  <div class="grid-head">
    <div>
      <div class="eyebrow">
        <span class="eyebrow__rule"></span>
        <span class="eyebrow__label">{section.eyebrow}</span>
      </div>
      <h2 class="grid-head__title">{section.title}</h2>
    </div>
    {section.showAllButton && (
      <a href={section.showAllButton.href} class="btn btn--outline-dark btn-md">
        {section.showAllButton.label}
        <Icon name="arrow" size={16} />
      </a>
    )}
  </div>
  <div class="service-cards">
    {services.map((s) => (
      <a href={getServiceUrl(s.slug)} class="service-card">
        <img src={getImageSrc(s.entry.homeImage)} alt={s.entry.cardTitle} class="service-card__img" loading="lazy" decoding="async" />
        <span class="service-card__scrim"></span>
        <span class="service-card__index">{s.entry.index}</span>
        <span class="service-card__body">
          <span class="service-card__title">{s.entry.cardTitle}</span>
          <span class="service-card__desc">{s.entry.cardDesc}</span>
          <span class="service-card__link">Explore →</span>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .grid-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    flex-wrap: wrap;
    margin-bottom: 46px;
  }
  .grid-head__title {
    font-size: clamp(26px, 4vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--c-dark);
    max-width: 640px;
  }
  .service-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 18px;
  }
  .service-card {
    position: relative;
    display: block;
    height: 460px;
    overflow: hidden;
    color: #fff;
  }
  .service-card:hover { color: #fff; }
  .service-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }
  .service-card:hover .service-card__img { transform: scale(1.04); }
  .service-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 35, 26, 0.25) 0%, rgba(20, 35, 26, 0.9) 62%);
  }
  .service-card__index {
    position: absolute;
    left: 26px;
    top: 24px;
    font-family: var(--f-head);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--c-yellow);
  }
  .service-card__body {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 26px;
  }
  .service-card__title {
    display: block;
    font-family: var(--f-head);
    font-size: 26px;
    line-height: 1.06;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .service-card__desc {
    display: block;
    font-size: 15px;
    line-height: 1.55;
    color: #C9D3C9;
    margin-bottom: 16px;
  }
  .service-card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-head);
    font-size: 14px;
    font-weight: 700;
    color: var(--c-yellow);
  }
</style>

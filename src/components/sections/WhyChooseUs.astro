---
import Icon from '../Icon.astro';
import { getImageSrc } from '../../lib/keystatic.ts';

export interface Props {
  section: {
    backgroundImage?: string | { src: string };
    eyebrow?: string;
    title: string;
    intro?: string;
    tiles: { icon: string; title: string; description: string }[];
  };
}

const { section } = Astro.props;
const imgSrc = getImageSrc(section.backgroundImage);
---
<section class="container section">
  <div class="whyus">
    <div class="stripes whyus__bg"></div>
    <img src={imgSrc} alt="" class="whyus__img" />
    <div class="whyus__grid split">
      <div class="whyus__intro">
        <div class="eyebrow">
          <span class="eyebrow__rule eyebrow__rule--yellow"></span>
          <span class="eyebrow__label eyebrow__label--yellow">{section.eyebrow}</span>
        </div>
        <h2 class="whyus__title">{section.title}</h2>
        {section.intro && <p class="whyus__p">{section.intro}</p>}
      </div>
      <div class="whyus__tiles">
        {section.tiles.map((tile) => (
          <div class="whyus__tile">
            <span class="whyus__icon"><Icon name={tile.icon} size={24} /></span>
            <h3>{tile.title}</h3>
            <p>{tile.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .whyus {
    position: relative;
    overflow: hidden;
    background: var(--c-dark);
    padding-block: clamp(28px, 5vw, 70px) 0;
    padding-left: clamp(28px, 5vw, 70px);
  }
  .whyus__bg { position: absolute; inset: 0; }
  .whyus__img {
    position: absolute;
    right: 0;
    top: 0;
    width: 34%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
  }
  .whyus__grid {
    position: relative;
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    gap: 64px;
    align-items: start;
  }
  .whyus__title {
    margin: 0 0 20px;
    font-size: clamp(25px, 3.2vw, 44px);
    line-height: 1.02;
    color: #fff;
  }
  .whyus__p {
    font-size: 17px;
    line-height: 1.64;
    color: var(--on-dark-mute-2);
  }
  .whyus__tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.16);
  }
  /* .split (global) stacks the grid at 1024px; desktop bleeds the tiles toward
     the image on the right, so stacked layouts need even padding instead */
  @media (max-width: 1024px) {
    .whyus {
      padding-right: clamp(28px, 5vw, 70px);
      padding-bottom: clamp(28px, 5vw, 70px);
    }
    .whyus__img { width: 100%; }
  }
  @media (max-width: 900px) {
    .whyus__tiles { grid-template-columns: 1fr; }
  }
  .whyus__tile {
    background: var(--c-dark);
    padding: 34px 30px;
  }
  .whyus__icon {
    display: flex;
    width: 52px;
    height: 52px;
    background: rgba(246, 213, 72, 0.14);
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }
  .whyus__tile h3 {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .whyus__tile p {
    font-size: 15.5px;
    line-height: 1.6;
    color: #9EAB9F;
  }
</style>

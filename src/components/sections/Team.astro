---
import { getImageSrc } from '../../lib/keystatic.ts';

export interface Props {
  section: {
    backgroundImage?: string | { src: string };
    title: string;
    description?: string;
    members: { value: string; title: string; description: string }[];
  };
}

const { section } = Astro.props;
const imgSrc = getImageSrc(section.backgroundImage);
---
<section class="container section">
  <div class="team">
    <div class="stripes team__bg"></div>
    <img src={imgSrc} alt="" class="team__img" />
    <div class="team__inner">
      <div class="team__head">
        <h2>{section.title}</h2>
        {section.description && <p>{section.description}</p>}
      </div>
      <div class="team__grid">
        {section.members.map((t) => (
          <div class="team__tile">
            <div class="team__value">{t.value}</div>
            <h3>{t.title}</h3>
            <p>{t.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .team {
    position: relative;
    overflow: hidden;
    background: var(--c-dark);
    padding: clamp(30px, 4.6vw, 64px) 0;
  }
  .team__bg { position: absolute; inset: 0; }
  .team__img {
    position: absolute;
    right: 0;
    top: 0;
    width: 32%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
  }
  .team__inner { position: relative; }
  .team__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    flex-wrap: wrap;
    margin-bottom: 44px;
  }
  .team__head h2 {
    font-size: clamp(24px, 3.2vw, 42px);
    color: #fff;
  }
  .team__head p {
    max-width: 380px;
    font-size: 16.5px;
    line-height: 1.62;
    color: var(--on-dark-mute-2);
  }
  .team__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.16);
  }
  @media (max-width: 1024px) {
    .team__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .team__grid { grid-template-columns: 1fr; }
  }
  .team__tile {
    background: var(--c-dark);
    padding: 32px 30px;
  }
  .team__value {
    font-family: var(--f-head);
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--c-yellow);
    line-height: 1;
  }
  .team__tile h3 {
    margin: 16px 0 8px;
    font-size: 19px;
    font-weight: 700;
    color: #fff;
  }
  .team__tile p {
    font-size: 15px;
    line-height: 1.6;
    color: #9EAB9F;
  }
</style>

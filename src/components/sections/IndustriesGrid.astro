---
import Icon from '../Icon.astro';
import { getAllIndustries } from '../../lib/keystatic.ts';

export interface Props {
  section: {
    eyebrow?: string;
    title: string;
    description?: string;
    ctaTitle?: string;
    ctaDescription?: string;
    ctaHref?: string;
  };
}

const { section } = Astro.props;
const industries = await getAllIndustries();
---
<section class="container section">
  <div class="grid-head">
    <div>
      <div class="eyebrow">
        <span class="eyebrow__rule"></span>
        <span class="eyebrow__label">{section.eyebrow}</span>
      </div>
      <h2 class="grid-head__title">{section.title}</h2>
    </div>
    {section.description && <p class="grid-head__p">{section.description}</p>}
  </div>
  <div class="industries">
    {industries.map((ind) => (
      <div class="industry">
        <span class="industry__icon"><Icon name={ind.entry.icon} size={24} stroke="#306A42" /></span>
        <h3>{ind.entry.name}</h3>
        {/* the overlay covers the resting content, so the icon is shown twice */}
        <p class="industry__overlay">
          <span class="industry__overlay-icon"><Icon name={ind.entry.icon} size={24} /></span>
          <span class="industry__overlay-text">{ind.entry.desc}</span>
        </p>
      </div>
    ))}
    <a href={section.ctaHref || '/contact'} class="industry industry--cta">
      <Icon name="plus" size={24} stroke="#14231A" />
      <span>
        <span class="industry__cta-title">{section.ctaTitle}</span>
        <span class="industry__cta-desc">{section.ctaDescription}</span>
      </span>
    </a>
  </div>
</section>

<style>
  .grid-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    flex-wrap: wrap;
    margin-bottom: 46px;
  }
  .grid-head__title {
    font-size: clamp(26px, 4vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--c-dark);
    max-width: 640px;
  }
  .grid-head__p {
    max-width: 360px;
    font-size: 16.5px;
    line-height: 1.62;
    color: var(--c-muted);
  }
  .industries {
    display: grid;
    /* min() is load-bearing: a bare minmax(250px, 1fr) overflows below
       250px + padding, which would reintroduce horizontal scroll at 320px */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 20px;
  }
  .industry {
    position: relative;
    overflow: hidden; /* clips the overlay's slide-up */
    background: #fff;
    border: 1px solid var(--c-line);
    /* fixed height keeps the overlay from ever reflowing the row */
    height: 168px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 26px;
    transition: border-color .18s ease;
  }
  .industry:hover,
  .industry:focus-within { border-color: var(--c-dark); }
  .industry__icon { display: block; }
  .industry h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--c-dark);
  }
  .industry__overlay {
    position: absolute; /* out of flow, so it cannot affect card height */
    inset: 0;
    background: var(--c-dark);
    padding: 26px;
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    opacity: 0;
    transform: translateY(10px);
    /* only opacity/transform — never anything that affects layout */
    transition: opacity .2s ease, transform .22s ease;
  }
  .industry:hover .industry__overlay,
  .industry:focus-within .industry__overlay {
    opacity: 1;
    transform: none;
  }
  .industry__overlay-icon {
    position: absolute;
    top: 26px;
    left: 26px;
    display: block;
  }
  /* the icon library bakes its colours into the path attributes, so restate
     them here — CSS wins over SVG presentation attributes */
  .industry__overlay-icon :global(svg *) { stroke: var(--c-yellow); }
  .industry__overlay-text {
    font-size: 15.5px;
    line-height: 1.55;
    color: #DCE4DD;
  }
  .industry--cta {
    background: var(--c-yellow);
    border-color: transparent;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--c-dark);
    transition: background .18s ease, color .18s ease;
  }
  .industry--cta:hover { background: var(--c-dark); color: var(--c-yellow); }
  .industry--cta .industry__icon { color: var(--c-dark); }
  .industry__cta-title {
    display: block;
    font-family: var(--f-head);
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .industry__cta-desc {
    display: block;
    font-size: 14.5px;
    line-height: 1.6;
  }

  /* no hover to reveal on touch, so show the description inline instead */
  @media (hover: none) {
    .industry {
      height: auto;
      min-height: 168px;
    }
    .industry__overlay {
      position: static;
      opacity: 1;
      transform: none;
      background: transparent;
      padding: 0;
      margin-top: 10px;
      justify-content: flex-start;
    }
    .industry__overlay-icon { display: none; }
    .industry__overlay-text { color: var(--c-muted-2); }
  }
</style>

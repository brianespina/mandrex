---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import { services } from '../../data/site.ts';

const steps = [
  { n: '01', title: 'Discovery call', desc: 'A 30-minute review of your current workload, tools, and pain points.' },
  { n: '02', title: 'Scope & proposal', desc: 'A written scope with deliverables, hours, turnaround times, and pricing.' },
  { n: '03', title: 'Onboarding', desc: 'Secure access, process documentation, and a two-week calibration period.' },
  { n: '04', title: 'Ongoing delivery', desc: 'Weekly updates, monthly reporting, and scope reviews as you grow.' },
];
---
<Layout title="Services — Mandrex VA Services" description="Engage a single specialist or a blended team. Every engagement starts with a documented scope, agreed turnaround times, and one point of contact.">
  <!-- INNER HERO -->
  <section class="inner-hero">
    <img src="/assets/photo-desk-laptops.jpg" alt="Team reviewing reports" class="inner-hero__img" />
    <div class="scrim"></div>
    <div class="container inner-hero__content">
      <div class="eyebrow">
        <span class="eyebrow__rule eyebrow__rule--yellow eyebrow__rule--lg"></span>
        <span class="eyebrow__label eyebrow__label--yellow eyebrow__label--lg">Services</span>
      </div>
      <h1>Support that fits how you work</h1>
      <p class="inner-hero__lead">Engage a single specialist or a blended team. Every engagement starts with a documented scope, agreed turnaround times, and one point of contact.</p>
      <div class="inner-hero__chips">
        {services.map((s) => (
          <a href={'/' + s.slug} class="chip-link">{s.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICE GRID -->
  <section class="container section">
    <div class="svc-grid">
      {services.map((s) => (
        <a href={'/' + s.slug} class="svc-card">
          <span class="svc-card__bar" style={`background:${s.topBarColor}`}></span>
          <span class="svc-card__icon"><Icon name={s.key} size={28} /></span>
          <h2 class="svc-card__title">{s.name}</h2>
          <p class="svc-card__desc">
            {s.key === 'bookkeeping' && 'Accurate records and better visibility into performance — organized, compliant, and ready for informed decisions.'}
            {s.key === 'admin' && 'Reliable day-to-day support that clears your admin backlog and streamlines how the business runs.'}
            {s.key === 'customer' && 'Responsive, professional customer experiences across every channel your buyers use.'}
            {s.key === 'executive' && 'Senior-level support that protects your calendar and keeps the details from reaching your desk.'}
          </p>
          <div class="svc-card__tags">
            {s.chips.map((c) => <span class="svc-card__tag">{c}</span>)}
          </div>
          <span class="svc-card__link">
            View full service
            <Icon name="arrow" size={16} stroke="#306A42" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ENGAGEMENT -->
  <section class="container section">
    <div class="engage">
      <div class="dotgrid-dark engage__bg"></div>
      <div class="engage__inner">
        <h2>How an engagement starts</h2>
        <div class="hairline-grid engage__steps">
          {steps.map((st) => (
            <div class="engage__step">
              <div class="engage__num">{st.n}</div>
              <h3>{st.title}</h3>
              <p>{st.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABand variant="green" heading="Not sure which service you need? We'll map it with you." button="Book a discovery call" href="/contact" />
</Layout>

<style>
  .inner-hero {
    position: relative;
    overflow: hidden;
    background: var(--c-dark);
    min-height: 460px;
    display: flex;
    align-items: center;
  }
  .inner-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .inner-hero__content { position: relative; padding: 92px var(--pad); }
  .inner-hero h1 {
    margin: 0 0 24px;
    font-size: clamp(28px, 4.7vw, 66px);
    line-height: 0.94;
    letter-spacing: -0.045em;
    color: #fff;
    max-width: 820px;
  }
  .inner-hero__lead {
    font-size: clamp(17px, 1.35vw, 19.5px);
    line-height: 1.58;
    color: var(--on-dark-mute-3);
    max-width: 600px;
  }
  .inner-hero__chips {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 36px;
  }
  .chip-link {
    display: inline-flex;
    align-items: center;
    height: 50px;
    padding: 0 22px;
    border: 1px solid rgba(255, 255, 255, 0.32);
    color: #fff;
    font-family: var(--f-head);
    font-size: 14.5px;
    font-weight: 600;
    transition: background .18s ease, border-color .18s ease, color .18s ease;
  }
  .chip-link:hover { background: var(--c-yellow); border-color: var(--c-yellow); color: var(--c-dark); }

  /* service grid */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (max-width: 900px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
  .svc-card {
    position: relative;
    overflow: hidden;
    display: block;
    background: #fff;
    border: 1px solid var(--c-line);
    padding: clamp(20px, 4.2vw, 44px);
    color: var(--c-text);
    transition: border-color .18s ease;
  }
  .svc-card:hover { border-color: var(--c-green); color: var(--c-text); }
  .svc-card__bar {
    position: absolute;
    right: 0;
    top: 0;
    width: 120px;
    height: 6px;
  }
  .svc-card__icon {
    display: flex;
    width: 64px;
    height: 64px;
    background: var(--c-dark);
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
  }
  .svc-card__title {
    margin: 0 0 14px;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--c-dark);
  }
  .svc-card__desc {
    margin: 0 0 24px;
    font-size: 16.5px;
    line-height: 1.64;
    color: var(--c-muted);
  }
  .svc-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 26px;
  }
  .svc-card__tag {
    padding: 7px 13px;
    background: var(--c-tint);
    font-size: 13.5px;
    color: var(--c-green);
    font-weight: 600;
  }
  .svc-card__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 700;
    color: var(--c-green);
  }

  /* engagement */
  .engage {
    position: relative;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--c-line);
    padding: 64px 0;
  }
  .dotgrid-dark {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(#E1E6DC 1.3px, transparent 1.3px);
    background-size: 24px 24px;
    opacity: 1;
  }
  .engage__inner { position: relative; }
  .engage__inner h2 {
    margin: 0 0 46px;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--c-dark);
  }
  .engage__steps {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 1024px) {
    .engage__steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .engage__steps { grid-template-columns: 1fr; }
  }
  .engage__step {
    background: #fff;
    padding: 34px 30px;
  }
  .engage__num {
    font-family: var(--f-head);
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--c-yellow);
    line-height: 0.9;
    margin-bottom: 18px;
  }
  .engage__step h3 {
    margin: 0 0 10px;
    font-size: 20px;
    font-weight: 700;
    color: var(--c-dark);
  }
  .engage__step p {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--c-muted-2);
  }

  @media (max-width: 880px) {
    .engage { padding: 40px 24px; }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import { services, industries, homeStats } from '../data/site.ts';
---
<Layout title="Mandrex VA Services — Virtual Assistance, Bookkeeping & Back-Office Support" description="Dependable virtual assistance, bookkeeping, administrative and customer support — back-office solutions so you can focus on growing your business.">
  <!-- HERO -->
  <section class="hero">
    <img src="/assets/photo-hero-boardroom.jpg" alt="Bookkeeping team reviewing reports around a boardroom table" class="hero__img" />
    <div class="scrim"></div>
    <div class="hero__content">
      <div class="eyebrow">
        <span class="eyebrow__rule eyebrow__rule--yellow eyebrow__rule--lg"></span>
        <span class="eyebrow__label eyebrow__label--yellow eyebrow__label--lg">Mandrex VA Services</span>
      </div>
      <h1 class="hero__h1">Helping businesses stay organized, productive, and ready to grow</h1>
      <p class="hero__lead">Virtual assistance, bookkeeping, administrative and customer support — dependable back-office solutions so you can focus on growing your business.</p>
      <div class="hero__ctas">
        <a href="/contact" class="btn btn--yellow btn-lg">Book a discovery call</a>
        <a href="/services" class="btn btn--outline-light btn-lg">
          See services
          <Icon name="arrow" size={17} />
        </a>
      </div>
    </div>
    <div class="hero__statbar">
      <div class="container">
        <div class="hero__stats">
          {homeStats.map((s) => (
            <div class={`hero__stat${s.accent ? ' hero__stat--accent' : ''}`}>
              <div class="hero__stat-value">{s.value}</div>
              <div class="hero__stat-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES GRID -->
  <section class="container section">
    <div class="grid-head">
      <div>
        <div class="eyebrow">
          <span class="eyebrow__rule"></span>
          <span class="eyebrow__label">What we do</span>
        </div>
        <h2 class="grid-head__title">Four service lines. One accountable team.</h2>
      </div>
      <a href="/services" class="btn btn--outline-dark btn-md">
        All services
        <Icon name="arrow" size={16} />
      </a>
    </div>
    <div class="service-cards">
      {services.map((s) => (
        <a href={'/' + s.slug} class="service-card">
          <img src={s.homeImage} alt={s.cardTitle} class="service-card__img" />
          <span class="service-card__scrim"></span>
          <span class="service-card__index">{s.index}</span>
          <span class="service-card__body">
            <span class="service-card__title">{s.cardTitle}</span>
            <span class="service-card__desc">{s.cardDesc}</span>
            <span class="service-card__link">Explore →</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="container section">
    <div class="whyus">
      <div class="stripes whyus__bg"></div>
      <img src="/assets/photo-partners.jpg" alt="Client partnership" class="whyus__img" />
      <div class="whyus__grid">
        <div class="whyus__intro">
          <div class="eyebrow">
            <span class="eyebrow__rule eyebrow__rule--yellow"></span>
            <span class="eyebrow__label eyebrow__label--yellow">Why choose us</span>
          </div>
          <h2 class="whyus__title">Standards, not shortcuts</h2>
          <p class="whyus__p">Outsourcing is about more than delegating tasks — it is trusting someone with an important part of your business. Every engagement is built around quality, accountability, and long-term partnership.</p>
        </div>
        <div class="whyus__tiles">
          <div class="whyus__tile">
            <span class="whyus__icon"><Icon name="shield" size={24} /></span>
            <h3>Reliable</h3>
            <p>Consistent support you can count on — the same standard of work, every week.</p>
          </div>
          <div class="whyus__tile">
            <span class="whyus__icon"><Icon name="target" size={24} /></span>
            <h3>Accurate</h3>
            <p>Detail-oriented work delivered with precision, reviewed before it reaches you.</p>
          </div>
          <div class="whyus__tile">
            <span class="whyus__icon"><Icon name="chart" size={24} /></span>
            <h3>Scalable</h3>
            <p>Flexible part-time or full-time solutions that grow alongside your business.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="container section">
    <div class="grid-head">
      <div>
        <div class="eyebrow">
          <span class="eyebrow__rule"></span>
          <span class="eyebrow__label">Industries</span>
        </div>
        <h2 class="grid-head__title">Sectors we know inside out</h2>
      </div>
      <p class="grid-head__p">Startups to established companies — with workflows and tooling we adapt to yours.</p>
    </div>
    <div class="industries">
      {industries.map((ind) => (
        <div class="industry">
          <span class="industry__icon"><Icon name={ind.icon} size={24} stroke="#306A42" /></span>
          <h3>{ind.name}</h3>
          <p>{ind.desc}</p>
        </div>
      ))}
      <a href="/contact" class="industry industry--cta">
        <Icon name="plus" size={24} stroke="#14231A" />
        <span>
          <span class="industry__cta-title">Not listed?</span>
          <span class="industry__cta-desc">Tell us what your operations need →</span>
        </span>
      </a>
    </div>
  </section>

  <!-- GLOBAL REACH -->
  <section class="container section">
    <div class="reach split">
      <div class="reach__media">
        <div class="reach__deco"></div>
        <img src="/assets/photo-statistics.jpg" alt="Reviewing management statistics" class="reach__img" />
        <img src="/assets/photo-meeting.jpg" alt="Client meeting" class="reach__inset" />
      </div>
      <div>
        <div class="eyebrow">
          <span class="eyebrow__rule eyebrow__rule--green"></span>
          <span class="eyebrow__label eyebrow__label--green">Global reach</span>
        </div>
        <h2 class="reach__title">Four countries.<br />One standard.</h2>
        <p class="reach__p">We support businesses in the United States, Australia, Canada, and the United Kingdom — including Arizona, California, Texas, New Jersey, New York, Massachusetts, Florida, Colorado, Connecticut, Maryland, Mississippi, Missouri, Oklahoma, Oregon, and South Carolina.</p>
        <div class="reach__stats">
          <div class="reach__stat">
            <div class="reach__stat-value">15+</div>
            <div class="reach__stat-label">U.S. states served</div>
          </div>
          <div class="reach__stat">
            <div class="reach__stat-value">3</div>
            <div class="reach__stat-label">Time-zone coverage windows</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL FEATURE -->
  <section class="container section">
    <div class="tfeature split">
      <div class="tfeature__card">
        <span class="tfeature__accent"></span>
        <div class="tfeature__mark">"</div>
        <blockquote class="tfeature__quote">Our books were three months behind. Within the first cycle Mandrex had everything reconciled — we now get a clean monthly report we actually use.</blockquote>
        <div class="tfeature__author">
          <div class="tfeature__avatar">OD</div>
          <div>
            <div class="tfeature__name">Operations Director</div>
            <div class="tfeature__role">Real estate group, Texas · sample testimonial</div>
          </div>
        </div>
      </div>
      <div>
        <h3 class="tfeature__heading">What clients say matters most</h3>
        <div class="tfeature__checks">
          <div class="tfeature__check"><Icon name="checkCircle" size={20} /><span>Deadlines met without follow-up reminders</span></div>
          <div class="tfeature__check"><Icon name="checkCircle" size={20} /><span>Clear documentation of how work gets done</span></div>
          <div class="tfeature__check"><Icon name="checkCircle" size={20} /><span>One point of contact who knows the account</span></div>
        </div>
        <a href="/testimonials" class="btn btn--dark btn-md">
          Read client stories
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <CTABand variant="dark" heading={`Let's build your back office`} paragraph="Tell us where your operations are stretched. We'll reply within one business day with a recommended scope." button="Get started today" href="/contact" />
</Layout>

<style>
  /* ---- HERO ---- */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--c-dark-2);
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 55%;
  }
  .hero__content {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: var(--maxw);
    width: 100%;
    margin: 0 auto;
    padding: 80px var(--pad) 190px;
  }
  .hero__h1 {
    margin: 0 0 28px;
    font-size: clamp(29px, 4.4vw, 62px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    max-width: 900px;
  }
  .hero__lead {
    margin: 0 0 40px;
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.56;
    color: #C4CFC5;
    max-width: 560px;
  }
  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero__statbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  .hero__stat {
    background: rgba(15, 26, 19, 0.74);
    backdrop-filter: blur(6px);
    padding: 28px 30px;
  }
  .hero__stat--accent { background: var(--c-yellow); }
  .hero__stat-value {
    font-family: var(--f-head);
    font-size: clamp(26px, 2.4vw, 32px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1;
  }
  .hero__stat--accent .hero__stat-value { color: var(--c-dark); }
  .hero__stat-label {
    margin-top: 6px;
    font-family: var(--f-head);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #A9B4AA;
  }
  .hero__stat--accent .hero__stat-label { color: var(--c-yellow-dark); }

  @media (max-width: 880px) {
    .hero { min-height: 0; }
    .hero__content { padding: 56px var(--pad) 56px; }
    .hero__statbar { position: static; }
  }

  /* ---- GRID HEAD ---- */
  .grid-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    flex-wrap: wrap;
    margin-bottom: 46px;
  }
  .grid-head__title {
    font-size: clamp(26px, 4vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--c-dark);
    max-width: 640px;
  }
  .grid-head__p {
    max-width: 360px;
    font-size: 16.5px;
    line-height: 1.62;
    color: var(--c-muted);
  }

  /* ---- SERVICE CARDS ---- */
  .service-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 18px;
  }
  .service-card {
    position: relative;
    display: block;
    height: 460px;
    overflow: hidden;
    color: #fff;
  }
  .service-card:hover { color: #fff; }
  .service-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }
  .service-card:hover .service-card__img { transform: scale(1.04); }
  .service-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 35, 26, 0.25) 0%, rgba(20, 35, 26, 0.9) 62%);
  }
  .service-card__index {
    position: absolute;
    left: 26px;
    top: 24px;
    font-family: var(--f-head);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--c-yellow);
  }
  .service-card__body {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 26px;
  }
  .service-card__title {
    display: block;
    font-family: var(--f-head);
    font-size: 26px;
    line-height: 1.06;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .service-card__desc {
    display: block;
    font-size: 15px;
    line-height: 1.55;
    color: #C9D3C9;
    margin-bottom: 16px;
  }
  .service-card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-head);
    font-size: 14px;
    font-weight: 700;
    color: var(--c-yellow);
  }

  /* ---- WHY US ---- */
  .whyus {
    position: relative;
    overflow: hidden;
    background: var(--c-dark);
    padding-block: clamp(28px, 5vw, 70px) 0;
    padding-left: clamp(28px, 5vw, 70px);
  }
  .whyus__bg { position: absolute; inset: 0; }
  .whyus__img {
    position: absolute;
    right: 0;
    top: 0;
    width: 34%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
  }
  .whyus__grid {
    position: relative;
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    gap: 64px;
    align-items: start;
  }
  .whyus__title {
    margin: 0 0 20px;
    font-size: clamp(25px, 3.2vw, 44px);
    line-height: 1.02;
    color: #fff;
  }
  .whyus__p {
    font-size: 17px;
    line-height: 1.64;
    color: var(--on-dark-mute-2);
  }
  .whyus__tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.16);
  }
  @media (max-width: 900px) {
    .whyus__tiles { grid-template-columns: 1fr; }
  }
  .whyus__tile {
    background: var(--c-dark);
    padding: 34px 30px;
  }
  .whyus__icon {
    display: flex;
    width: 52px;
    height: 52px;
    background: rgba(246, 213, 72, 0.14);
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }
  .whyus__tile h3 {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .whyus__tile p {
    font-size: 15.5px;
    line-height: 1.6;
    color: #9EAB9F;
  }

  /* ---- INDUSTRIES ---- */
  .industries {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .industry {
    background: #fff;
    padding: 30px;
    transition: background .18s ease;
  }
  .industry:hover { background: var(--c-tint-2); }
  .industry__icon { display: block; margin-bottom: 18px; }
  .industry h3 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 700;
    color: var(--c-dark);
  }
  .industry p {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--c-muted-2);
  }
  .industry--cta {
    background: var(--c-yellow);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--c-dark);
  }
  .industry--cta:hover { background: var(--c-dark); color: var(--c-yellow); }
  .industry--cta .industry__icon { color: var(--c-dark); }
  .industry__cta-title {
    display: block;
    font-family: var(--f-head);
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .industry__cta-desc {
    display: block;
    font-size: 14.5px;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .industries { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .industries { grid-template-columns: 1fr; }
  }

  /* ---- GLOBAL REACH ---- */
  .reach {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 72px;
    align-items: center;
  }
  .reach__media {
    position: relative;
    padding: 0 0 52px 52px;
  }
  .reach__deco {
    position: absolute;
    left: 0;
    top: 40px;
    width: 250px;
    height: 280px;
    background-image: radial-gradient(#CBD3C6 1.3px, transparent 1.3px);
    background-size: 22px 22px;
  }
  .reach__img {
    position: relative;
    width: 100%;
    height: 400px;
    object-fit: cover;
  }
  .reach__inset {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 230px;
    height: 180px;
    object-fit: cover;
    border: 10px solid var(--c-bg);
  }
  .reach__title {
    margin: 0 0 22px;
    font-size: clamp(25px, 3.4vw, 46px);
    line-height: 1;
    color: var(--c-dark);
  }
  .reach__p {
    margin: 0 0 32px;
    font-size: 17px;
    line-height: 1.64;
    color: var(--c-muted);
  }
  .reach__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
  }
  .reach__stat {
    background: #fff;
    padding: 22px 24px;
  }
  .reach__stat-value {
    font-family: var(--f-head);
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--c-green);
    line-height: 1;
  }
  .reach__stat-label {
    margin-top: 8px;
    font-size: 15px;
    color: var(--c-muted-2);
  }

  @media (max-width: 880px) {
    .reach__media { padding: 0; }
    .reach__deco { display: none; }
    .reach__inset { position: static; width: 60%; height: auto; aspect-ratio: 4 / 3; border-width: 8px; margin-top: -34px; }
  }

  /* ---- TESTIMONIAL FEATURE ---- */
  .tfeature {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 64px;
    align-items: center;
  }
  .tfeature__card {
    position: relative;
    background: #fff;
    border: 1px solid var(--c-line);
    padding: clamp(28px, 4vw, 52px) clamp(24px, 3.6vw, 48px);
  }
  .tfeature__accent {
    position: absolute;
    left: 0;
    top: 0;
    width: 6px;
    height: 100%;
    background: var(--c-yellow);
  }
  .tfeature__mark {
    font-family: var(--f-head);
    font-size: 64px;
    line-height: 0.6;
    font-weight: 800;
    color: var(--c-yellow);
  }
  .tfeature__quote {
    margin: 18px 0 30px;
    font-family: var(--f-head);
    font-size: 29px;
    line-height: 1.26;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--c-dark);
  }
  .tfeature__author {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .tfeature__avatar {
    width: 48px;
    height: 48px;
    background: var(--c-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 700;
    color: var(--c-yellow);
  }
  .tfeature__name {
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 700;
    color: var(--c-dark);
  }
  .tfeature__role {
    font-size: 14px;
    color: var(--c-muted-3);
    margin-top: 2px;
  }
  .tfeature__heading {
    margin: 0 0 26px;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--c-dark);
    text-transform: uppercase;
  }
  .tfeature__checks {
    display: grid;
    gap: 14px;
    margin-bottom: 34px;
  }
  .tfeature__check {
    display: flex;
    gap: 14px;
    align-items: center;
    background: #fff;
    border: 1px solid var(--c-line);
    padding: 18px 20px;
  }
  .tfeature__check span {
    font-size: 16px;
    line-height: 1.5;
    color: var(--c-text);
  }
</style>

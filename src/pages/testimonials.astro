---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { testimonials } from '../data/site.ts';
---
<Layout title="Testimonials — Mandrex VA Services" description="What working with Mandrex looks like — client outcomes across bookkeeping, administrative, customer support, and executive assistance.">
  <!-- INNER HERO -->
  <section class="inner-hero">
    <img src="/assets/photo-partners.jpg" alt="Client partnership meeting" class="inner-hero__img" />
    <div class="scrim"></div>
    <div class="container inner-hero__content">
      <div class="eyebrow">
        <span class="eyebrow__rule eyebrow__rule--yellow eyebrow__rule--lg"></span>
        <span class="eyebrow__label eyebrow__label--yellow eyebrow__label--lg">Testimonials</span>
      </div>
      <h1>What working with Mandrex looks like</h1>
      <p class="inner-hero__lead">The quotes on this page are samples written as placeholders — to be replaced with approved client feedback before launch.</p>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="container section-featured">
    <div class="featured">
      <div class="stripes featured__bg"></div>
      <div class="featured__grid split">
        <div>
          <div class="featured__mark">"</div>
          <blockquote class="featured__quote">Our books were three months behind. Within the first cycle Mandrex had everything reconciled, and we now get a clean monthly report we actually use in decisions.</blockquote>
          <div class="featured__author">
            <div class="featured__avatar">OD</div>
            <div>
              <div class="featured__name">Operations Director</div>
              <div class="featured__role">Real estate group, Texas · sample testimonial</div>
            </div>
          </div>
        </div>
        <div class="featured__stats">
          <div class="featured__stat">
            <div class="featured__stat-value">1 day</div>
            <div class="featured__stat-label">Average first response to inquiries</div>
          </div>
          <div class="featured__stat">
            <div class="featured__stat-value">Long-term</div>
            <div class="featured__stat-label">Client relationships built on accuracy and trust</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GRID -->
  <section class="container section-grid">
    <div class="t-grid">
      {testimonials.map((t) => (
        <div class="t-card">
          <div class="t-card__tag">
            <span class="t-card__rule"></span>
            <span>{t.service}</span>
          </div>
          <p class="t-card__quote">{t.quote}</p>
          <div class="t-card__role">{t.role}</div>
          <div class="t-card__detail">{t.detail}</div>
        </div>
      ))}
      <div class="t-card t-card--cta">
        <h3>Your story next</h3>
        <p>Start with a discovery call and see what a documented, accountable back office feels like.</p>
        <a href="/contact" class="btn btn--dark btn-md">
          Book a call
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- CLOSING BAND -->
  <section class="container section-closing">
    <div class="closing">
      <img src="/assets/photo-team.jpg" alt="Long-term client relationships" class="closing__img" />
      <div class="closing__card">
        <p>Every engagement is built on accuracy, responsiveness, and trust.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .inner-hero {
    position: relative;
    overflow: hidden;
    background: var(--c-dark);
    min-height: 460px;
    display: flex;
    align-items: center;
  }
  .inner-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .inner-hero__content { position: relative; padding: 92px var(--pad); }
  .inner-hero h1 {
    margin: 0 0 24px;
    font-size: clamp(28px, 4.7vw, 66px);
    line-height: 0.94;
    letter-spacing: -0.045em;
    color: #fff;
    max-width: 860px;
  }
  .inner-hero__lead {
    font-size: clamp(17px, 1.35vw, 19.5px);
    line-height: 1.58;
    color: var(--on-dark-mute-3);
    max-width: 600px;
  }

  /* featured */
  .section-featured { padding-top: 100px; }
  .featured {
    position: relative;
    overflow: hidden;
    background: var(--c-dark);
    padding: clamp(30px, 4.6vw, 64px) 0;
    padding-left: clamp(30px, 4.6vw, 64px);
  }
  .featured__bg { position: absolute; inset: 0; }
  .featured__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 64px;
    align-items: center;
  }
  .featured__mark {
    font-family: var(--f-head);
    font-size: 72px;
    line-height: 0.6;
    font-weight: 800;
    color: var(--c-yellow);
  }
  .featured__quote {
    margin: 20px 0 30px;
    font-family: var(--f-head);
    font-size: clamp(21px, 2.4vw, 33px);
    line-height: 1.26;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: #fff;
  }
  .featured__author {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .featured__avatar {
    width: 48px;
    height: 48px;
    background: var(--c-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 800;
    color: var(--c-dark);
  }
  .featured__name {
    font-family: var(--f-head);
    font-size: 15.5px;
    font-weight: 700;
    color: #fff;
  }
  .featured__role {
    font-size: 14px;
    color: var(--on-dark-mute);
    margin-top: 2px;
  }
  .featured__stats {
    display: grid;
    gap: 1px;
    background: rgba(255, 255, 255, 0.16);
  }
  .featured__stat {
    background: var(--c-dark);
    padding: 0 0 26px;
  }
  .featured__stat:nth-child(2) { padding: 26px 0 0; }
  .featured__stat-value {
    font-family: var(--f-head);
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: #fff;
    line-height: 1;
  }
  .featured__stat-label {
    font-size: 15px;
    line-height: 1.5;
    color: #9EAB9F;
    margin-top: 8px;
  }

  /* grid */
  .section-grid { padding-top: 16px; }
  .t-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-top: none;
  }
  @media (max-width: 900px) {
    .t-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .t-grid { grid-template-columns: 1fr; }
  }
  .t-card {
    background: #fff;
    padding: 40px;
  }
  .t-card__tag {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }
  .t-card__rule {
    display: block;
    width: 26px;
    height: 3px;
    background: var(--c-green);
  }
  .t-card__tag span {
    font-family: var(--f-head);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-green);
  }
  .t-card__quote {
    margin: 0 0 26px;
    font-size: 17px;
    line-height: 1.62;
    color: var(--c-text);
  }
  .t-card__role {
    font-family: var(--f-head);
    font-size: 14.5px;
    font-weight: 700;
    color: var(--c-dark);
  }
  .t-card__detail {
    font-size: 14px;
    color: var(--c-muted-3);
    margin-top: 3px;
  }
  .t-card--cta {
    background: var(--c-yellow);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .t-card--cta h3 {
    margin: 0 0 12px;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--c-dark);
  }
  .t-card--cta p {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 1.6;
    color: #4A3E0C;
  }
  .t-card--cta .btn { align-self: flex-start; }

  /* closing */
  .section-closing { padding: 100px var(--pad) 110px; }
  .closing { position: relative; }
  .closing__img {
    width: 100%;
    height: 360px;
    object-fit: cover;
  }
  .closing__card {
    position: absolute;
    left: 44px;
    bottom: 44px;
    background: #fff;
    padding: 28px 32px;
    max-width: 460px;
  }
  .closing__card p {
    font-family: var(--f-head);
    font-size: 21px;
    line-height: 1.34;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--c-dark);
  }

  @media (max-width: 640px) {
    .closing__card { left: 20px; right: 20px; bottom: 20px; }
  }
</style>

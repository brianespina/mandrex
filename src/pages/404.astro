---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Page not found — Mandrex VA Services" description="The page you're looking for doesn't exist or has moved.">
  <section class="notfound">
    <img src="/assets/photo-hero-boardroom.jpg" alt="" class="notfound__img" aria-hidden="true" />
    <div class="scrim"></div>
    <div class="container notfound__content">
      <div class="eyebrow">
        <span class="eyebrow__rule eyebrow__rule--yellow eyebrow__rule--lg"></span>
        <span class="eyebrow__label eyebrow__label--yellow eyebrow__label--lg">Error 404</span>
      </div>
      <h1 class="notfound__title">This page has moved on</h1>
      <p class="notfound__lead">The page you're looking for doesn't exist or has been moved. Let's get you back to business.</p>
      <div class="notfound__ctas">
        <a href="/" class="btn btn--yellow btn-lg">
          Back to home
          <Icon name="arrow" size={18} />
        </a>
        <a href="/services" class="btn btn--outline-light btn-lg">See services</a>
      </div>
      <nav class="notfound__nav">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/about">About</a>
        <a href="/testimonials">Testimonials</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .notfound {
    position: relative;
    overflow: hidden;
    background: var(--c-dark-2);
    min-height: 100vh;
    display: flex;
    align-items: center;
  }
  .notfound__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 55%;
  }
  .notfound__content {
    position: relative;
    padding: 120px var(--pad);
  }
  .notfound__title {
    margin: 0 0 24px;
    font-size: clamp(34px, 5vw, 68px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    max-width: 760px;
  }
  .notfound__lead {
    margin: 0 0 40px;
    font-size: clamp(17px, 1.45vw, 21px);
    line-height: 1.56;
    color: #C4CFC5;
    max-width: 560px;
  }
  .notfound__ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }
  .notfound__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    max-width: 560px;
  }
  .notfound__nav a {
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    transition: color .18s ease;
  }
  .notfound__nav a:hover { color: var(--c-yellow); }
</style>

---
import Layout from '../layouts/Layout.astro';
import SectionRenderer from '../components/SectionRenderer.astro';
import { getPage, getAllReusableSections } from '../lib/keystatic.ts';

const page = await getPage('contact');
const reusableSections = await getAllReusableSections();

if (!page) {
  throw new Error('Contact page not found');
}
---
<Layout title={page.title} description={page.description}>
  {page.sections.map((section) => (
    <SectionRenderer section={section} reusableSections={reusableSections} />
  ))}
</Layout>

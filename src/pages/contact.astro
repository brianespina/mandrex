---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { footerLinks } from '../data/site.ts';
const { contact } = footerLinks;

const needOptions = [
  { key: 'bookkeeping', label: 'Bookkeeping' },
  { key: 'admin', label: 'Administrative support' },
  { key: 'customer', label: 'Customer support' },
  { key: 'executive', label: 'Executive assistance' },
  { key: 'unsure', label: 'Not sure yet' },
];
---
<Layout title="Contact Us — Mandrex VA Services" description="Tell us what your operations need. We'll reply within one business day with next steps.">
  <!-- INNER HERO -->
  <section class="inner-hero">
    <img src="/assets/photo-hero-team.jpg" alt="The Mandrex team in a working session" class="inner-hero__img" style="object-position:62% 46%" />
    <div class="scrim"></div>
    <div class="container inner-hero__content">
      <div class="eyebrow">
        <span class="eyebrow__rule eyebrow__rule--yellow eyebrow__rule--lg"></span>
        <span class="eyebrow__label eyebrow__label--yellow eyebrow__label--lg">Contact us</span>
      </div>
      <h1>Tell us what your operations need</h1>
      <p class="inner-hero__lead">We'd love to learn more about your business and discuss how our team can support your operations. Send us a message and we'll get back to you as soon as possible.</p>
      <div class="factstrip">
        <div class="factstrip__item">
          <div class="factstrip__label">Reply time</div>
          <div class="factstrip__value">Within 1 business day</div>
        </div>
        <div class="factstrip__item">
          <div class="factstrip__label">Coverage</div>
          <div class="factstrip__value">Mon–Fri · US, UK & AU hours</div>
        </div>
        <div class="factstrip__item">
          <div class="factstrip__label">Registered</div>
          <div class="factstrip__value">Wyoming, USA</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT + FORM -->
  <section class="container contact-section">
    <!-- details -->
    <div class="contact-details">
      <h2 class="contact-details__title">Contact details</h2>
      <div class="hairline-grid contact-details__list">
        <div class="cd-row">
          <span class="cd-icon"><Icon name="envelope" size={21} stroke="#306A42" /></span>
          <span>
            <span class="cd-label">Email</span>
            <a href={`mailto:${contact.email}`} class="cd-value">{contact.email}</a>
          </span>
        </div>
        <div class="cd-row">
          <span class="cd-icon"><Icon name="phone" size={21} stroke="#306A42" /></span>
          <span>
            <span class="cd-label">Phone</span>
            <a href={contact.phone1Href} class="cd-value">{contact.phone1}</a>
            <a href={contact.phone2Href} class="cd-value-2">{contact.phone2}</a>
          </span>
        </div>
        <div class="cd-row cd-row--block">
          <span class="cd-label cd-label--block">Prefer to talk?</span>
          <a href="/contact" class="btn btn--outline-dark btn-md">
            Book a 30-minute call
            <Icon name="arrow" size={16} />
          </a>
        </div>
        <div class="cd-row cd-row--block">
          <span class="cd-label cd-label--block">Follow</span>
          <span class="cd-socials">
            {footerLinks.socials.map((s) => <a href={s.href} rel="noopener nofollow">{s.label}</a>)}
          </span>
        </div>
      </div>
    </div>

    <!-- form -->
    <div class="form-card">
      <span class="form-card__bar"></span>
      <div class="form-card__success" data-success hidden>
        <span class="form-card__success-icon"><Icon name="successCheck" size={30} stroke="#306A42" /></span>
        <div class="form-card__success-title">Message received</div>
        <p class="form-card__success-text">We'll review your inquiry and reply within one business day with next steps.</p>
        <a href="#" class="form-card__reset" data-reset>Send another message →</a>
      </div>
      <form class="form-card__form" data-form>
        <h2 class="form-card__title">Send us a message</h2>
        <div class="form-row">
          <label class="field">
            <span class="field__label">Full name</span>
            <input type="text" name="name" placeholder="Jane Doe" required />
          </label>
          <label class="field">
            <span class="field__label">Work email</span>
            <input type="email" name="email" placeholder="jane@company.com" required />
          </label>
        </div>
        <div class="form-row">
          <label class="field">
            <span class="field__label">Company</span>
            <input type="text" name="company" placeholder="Company name" />
          </label>
          <label class="field">
            <span class="field__label">Phone (optional)</span>
            <input type="tel" name="phone" placeholder="+1 000 000 0000" />
          </label>
        </div>
        <div class="field">
          <span class="field__label">Support needed</span>
          <div class="need-chips" data-need>
            {needOptions.map((o) => (
              <button type="button" class="need-chip" data-need-val={o.key}>{o.label}</button>
            ))}
          </div>
        </div>
        <label class="field">
          <span class="field__label">How can we help?</span>
          <textarea name="message" rows="5" placeholder="Tell us about your current workload, tools, and the tasks you'd like to hand over." required></textarea>
        </label>
        <button type="submit" class="form-card__submit">Send message</button>
        <p class="form-card__note">By sending this message you agree to be contacted about your inquiry. We never share your details.</p>
      </form>
    </div>
  </section>
</Layout>

<style>
  .inner-hero {
    position: relative;
    overflow: hidden;
    background: var(--c-dark);
    min-height: 460px;
    display: flex;
    align-items: center;
  }
  .inner-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .inner-hero__content { position: relative; padding: 92px var(--pad); }
  .inner-hero h1 {
    margin: 0 0 24px;
    font-size: clamp(28px, 4.7vw, 66px);
    line-height: 0.94;
    letter-spacing: -0.045em;
    color: #fff;
    max-width: 780px;
  }
  .inner-hero__lead {
    font-size: clamp(17px, 1.35vw, 19.5px);
    line-height: 1.58;
    color: var(--on-dark-mute-3);
    max-width: 600px;
  }
  .factstrip {
    display: flex;
    flex-wrap: wrap;
    gap: 44px;
    margin-top: 38px;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .factstrip__label {
    font-family: var(--f-head);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-mute-4);
    margin-bottom: 7px;
  }
  .factstrip__value {
    font-family: var(--f-head);
    font-size: 19px;
    font-weight: 700;
    color: #fff;
  }

  /* contact section */
  .contact-section {
    display: grid;
    grid-template-columns: 0.88fr 1.12fr;
    gap: 72px;
    align-items: start;
    padding: 88px var(--pad) 110px;
  }
  .contact-details__title {
    margin: 0 0 30px;
    font-size: clamp(22px, 2.6vw, 34px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--c-dark);
  }
  .contact-details__list { grid-template-columns: 1fr; }
  .cd-row {
    background: #fff;
    padding: 24px 26px;
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .cd-row--block { flex-direction: column; align-items: flex-start; }
  .cd-icon {
    display: flex;
    width: 46px;
    height: 46px;
    flex: none;
    background: var(--c-tint);
    align-items: center;
    justify-content: center;
  }
  .cd-label {
    display: block;
    font-family: var(--f-head);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-muted-3);
    margin-bottom: 5px;
  }
  .cd-label--block { margin-bottom: 14px; }
  .cd-value {
    font-family: var(--f-head);
    font-size: 17px;
    font-weight: 700;
    color: var(--c-dark);
  }
  .cd-value-2 {
    display: block;
    font-size: 15px;
    color: var(--c-muted);
    margin-top: 3px;
  }
  .cd-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }
  .cd-socials a {
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 700;
    color: var(--c-dark);
  }

  /* form */
  .form-card {
    position: relative;
    background: #fff;
    border: 1px solid var(--c-line);
    padding: clamp(28px, 4vw, 52px) clamp(24px, 3.6vw, 48px);
  }
  .form-card__bar {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 6px;
    background: var(--c-green);
  }
  .form-card__title {
    margin: 0 0 32px;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--c-dark);
  }
  .form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 22px;
    margin-bottom: 22px;
  }
  .field {
    display: block;
  }
  .field + .field { margin-top: 22px; }
  .form-row + .field { margin-top: 0; }
  .field__label {
    display: block;
    font-family: var(--f-head);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-muted-2);
    margin-bottom: 9px;
  }
  .field input,
  .field textarea {
    width: 100%;
    height: 52px;
    padding: 0 15px;
    border: 1px solid var(--c-input);
    font-size: 16px;
    color: var(--c-dark);
    background: var(--c-bg);
    transition: border-color .18s ease, background .18s ease, outline .18s ease;
  }
  .field textarea {
    height: auto;
    padding: 15px;
    line-height: 1.55;
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: var(--c-green);
    outline: none;
    background: #fff;
  }
  .need-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .need-chip {
    height: 44px;
    padding: 0 18px;
    border: 1px solid var(--c-input);
    background: #fff;
    color: var(--c-dark);
    font-family: var(--f-head);
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background .18s ease, color .18s ease, border-color .18s ease;
  }
  .need-chip[data-active="true"] {
    border-color: var(--c-green);
    background: var(--c-green);
    color: #fff;
  }
  .form-card__submit {
    height: 60px;
    background: var(--c-dark);
    color: #fff;
    border: none;
    font-family: var(--f-head);
    font-size: 16.5px;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    transition: background .18s ease;
  }
  .form-card__submit:hover { background: var(--c-green); }
  .form-card__note {
    margin: 18px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--c-muted-3);
  }

  /* success */
  .form-card__success {
    padding: 56px 0;
    text-align: center;
  }
  .form-card__success-icon {
    display: inline-flex;
    width: 64px;
    height: 64px;
    background: var(--c-tint);
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }
  .form-card__success-title {
    font-family: var(--f-head);
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--c-dark);
    margin-bottom: 12px;
    text-transform: uppercase;
  }
  .form-card__success-text {
    margin: 0 auto 28px;
    font-size: 16.5px;
    line-height: 1.62;
    color: var(--c-muted);
    max-width: 400px;
  }
  .form-card__reset {
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 700;
  }

  @media (max-width: 1024px) {
    .contact-section { grid-template-columns: 1fr; gap: 40px; }
  }
</style>

<script>
  const form = document.querySelector('[data-form]') as HTMLFormElement | null;
  const success = document.querySelector('[data-success]') as HTMLElement | null;
  const needWrap = document.querySelector('[data-need]') as HTMLElement | null;
  const chips = needWrap?.querySelectorAll('[data-need-val]') as NodeListOf<HTMLButtonElement>;
  const reset = document.querySelector('[data-reset]') as HTMLAnchorElement | null;

  let selectedNeed = '';

  chips?.forEach((chip) => {
    chip.addEventListener('click', () => {
      selectedNeed = chip.dataset.needVal!;
      chips.forEach((c) => c.setAttribute('data-active', String(c === chip)));
    });
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // NOTE: client-side success state only. Wire to a real endpoint (email/Worker/CRM) before launch.
    form.hidden = true;
    success!.hidden = false;
    success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  reset?.addEventListener('click', (e) => {
    e.preventDefault();
    form!.reset();
    selectedNeed = '';
    chips?.forEach((c) => c.setAttribute('data-active', 'false'));
    form.hidden = false;
    success!.hidden = true;
  });
</script>

---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import { aboutStats, teamComposition } from '../data/site.ts';

const howWeWork = [
  { icon: 'shield', title: 'Quality', desc: 'Work reviewed against a checklist before it reaches your desk.' },
  { icon: 'clock', title: 'Reliability', desc: 'Agreed turnaround times, met without reminders.' },
  { icon: 'proBriefcase', title: 'Professionalism', desc: 'Clear communication, confidentiality, and documented processes.' },
  { icon: 'partnership', title: 'Partnership', desc: 'Support that adapts as your business and workload change.' },
];
---
<Layout title="About Us — Mandrex VA Services" description="Mandrex VA Services partners with businesses to simplify day-to-day operations through reliable virtual assistance, bookkeeping, customer support, and administrative solutions.">
  <!-- INNER HERO -->
  <section class="inner-hero">
    <img src="/assets/photo-desk-review.jpg" alt="Reviewing a business metrics report" class="inner-hero__img" style="object-position:52% 45%" />
    <div class="scrim"></div>
    <div class="container inner-hero__content">
      <div class="eyebrow">
        <span class="eyebrow__rule eyebrow__rule--yellow eyebrow__rule--lg"></span>
        <span class="eyebrow__label eyebrow__label--yellow eyebrow__label--lg">About Mandrex</span>
      </div>
      <h1>Experience meets dependable support</h1>
      <p class="inner-hero__lead">Mandrex VA Services partners with businesses to simplify day-to-day operations through reliable virtual assistance, bookkeeping, customer support, and administrative solutions.</p>
      <p class="inner-hero__tagline">Turning challenges into opportunities, one solution at a time.</p>
    </div>
  </section>

  <!-- STATS -->
  <section class="container about-stats-wrap">
    <div class="hairline-grid about-stats">
      {aboutStats.map((st) => (
        <div class="about-stat">
          <div class="about-stat__value">{st.value}</div>
          <div class="about-stat__label">{st.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="container section">
    <div class="founder split">
      <div>
        <div class="founder__photo-wrap">
          <div class="founder__deco"></div>
          <img src="/assets/founder-nikka.jpg" alt="Nikka Nava, Founder" class="founder__photo" />
          <div class="founder__nameplate">
            <div class="founder__name">Nikka Nava</div>
            <div class="founder__role">Founder & CEO</div>
          </div>
        </div>
      </div>
      <div>
        <div class="eyebrow">
          <span class="eyebrow__rule"></span>
          <span class="eyebrow__label">Founder's note</span>
        </div>
        <h2 class="founder__title">Built from 13 years in the numbers</h2>
        <p class="founder__p founder__p--lead">With over 13 years of experience in accounting, bookkeeping, accounts payable, expense management, and financial operations, I've built my career around helping businesses stay organized, efficient, and financially on track.</p>
        <p class="founder__p">Over the years I've worked beyond traditional bookkeeping — managing processes, solving operational challenges, improving workflows, and supporting the day-to-day tasks that keep things moving. These experiences shaped the way I work today: with attention to detail, accountability, and a focus on making operations more efficient.</p>
        <p class="founder__p">Mandrex VA Services was created to provide businesses with reliable, skilled, and professional virtual support — backed by real-world experience. My vision is a VA agency businesses can genuinely rely on, whether they need bookkeeping and accounting support, administrative assistance, or help managing everyday operations.</p>
        <p class="founder__p founder__p--last">Outsourcing is about more than delegating tasks. It's about finding someone you can trust with an important part of your business. That's why Mandrex is built around quality, reliability, professionalism, and long-term partnerships.</p>
        <div class="founder__mission">
          <p>To help businesses work smarter, stay organized, and have the right support to grow.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- VISION / MISSION -->
  <section class="container section">
    <div class="vm-grid">
      <div class="vm-card">
        <div class="vm-card__blob vm-card__blob--green"></div>
        <div class="vm-card__inner">
          <span class="vm-card__icon vm-card__icon--green"><Icon name="target" size={26} /></span>
          <h3>Our vision</h3>
          <p>To be the leading provider of innovative and customized business solutions, driving growth and success for companies of all sizes — delivering exceptional value through a culture of excellence, innovation, and client success.</p>
        </div>
      </div>
      <div class="vm-card">
        <div class="vm-card__blob vm-card__blob--red"></div>
        <div class="vm-card__inner">
          <span class="vm-card__icon vm-card__icon--red"><Icon name="crosshair" size={26} /></span>
          <h3>Our mission</h3>
          <p>To simplify business operations and drive growth for our clients through customized, cost-effective solutions that streamline processes and boost efficiency — becoming a trusted partner for businesses of all sizes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="container section">
    <div class="team">
      <div class="stripes team__bg"></div>
      <img src="/assets/photo-team.jpg" alt="The Mandrex team" class="team__img" />
      <div class="team__inner">
        <div class="team__head">
          <h2>The team behind your account</h2>
          <p>Thirteen specialists across bookkeeping, virtual assistance, SEO, and IT — every engagement led by a named point of contact.</p>
        </div>
        <div class="team__grid">
          {teamComposition.map((t) => (
            <div class="team__tile">
              <div class="team__value">{t.value}</div>
              <h3>{t.title}</h3>
              <p>{t.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="container section">
    <h2 class="hww__title">How we work</h2>
    <div class="hairline-grid hww__grid">
      {howWeWork.map((w) => (
        <div class="hww__cell">
          <span class="hww__icon"><Icon name={w.icon} size={24} stroke="#306A42" /></span>
          <h3>{w.title}</h3>
          <p>{w.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <CTABand variant="green" heading="Welcome to Mandrex. Let's talk about your operations." button="Contact us" href="/contact" />
</Layout>

<style>
  .inner-hero {
    position: relative;
    overflow: hidden;
    background: var(--c-dark);
    min-height: 460px;
    display: flex;
    align-items: center;
  }
  .inner-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .inner-hero__content { position: relative; padding: 92px var(--pad); }
  .inner-hero h1 {
    margin: 0 0 24px;
    font-size: clamp(28px, 4.7vw, 66px);
    line-height: 0.94;
    letter-spacing: -0.045em;
    color: #fff;
    max-width: 780px;
  }
  .inner-hero__lead {
    font-size: clamp(17px, 1.35vw, 19.5px);
    line-height: 1.58;
    color: var(--on-dark-mute-3);
    max-width: 600px;
  }
  .inner-hero__tagline {
    margin: 30px 0 0;
    font-family: var(--f-head);
    font-size: 18px;
    line-height: 1.4;
    font-weight: 700;
    color: var(--c-yellow);
  }

  /* stats */
  .about-stats-wrap { padding: 0 var(--pad); }
  .about-stats {
    grid-template-columns: repeat(4, 1fr);
    margin-top: -1px;
  }
  @media (max-width: 1024px) {
    .about-stats { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .about-stats { grid-template-columns: 1fr; }
  }
  .about-stat {
    background: #fff;
    padding: 32px;
  }
  .about-stat__value {
    font-family: var(--f-head);
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--c-green);
    line-height: 1;
  }
  .about-stat__label {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--c-muted-2);
  }

  /* founder */
  .founder {
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    gap: 64px;
    align-items: start;
  }
  .founder__photo-wrap { position: relative; }
  .founder__deco {
    position: absolute;
    left: -18px;
    top: -18px;
    width: 110px;
    height: 110px;
    background-image: radial-gradient(#CBD3C6 1.3px, transparent 1.3px);
    background-size: 20px 20px;
  }
  .founder__photo {
    position: relative;
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: center 20%;
  }
  .founder__nameplate {
    position: relative;
    background: var(--c-dark);
    padding: 26px 28px;
  }
  .founder__name {
    font-family: var(--f-head);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .founder__role {
    font-family: var(--f-head);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-yellow);
    margin-top: 8px;
  }
  .founder__title {
    margin: 0 0 26px;
    font-size: clamp(24px, 3.2vw, 42px);
    line-height: 1.02;
    color: var(--c-dark);
  }
  .founder__p {
    margin: 0 0 20px;
    font-size: 17px;
    line-height: 1.68;
    color: var(--c-muted);
  }
  .founder__p--lead {
    font-size: 17.5px;
    color: var(--c-text);
  }
  .founder__p--last { margin-bottom: 30px; }
  .founder__mission {
    background: var(--c-yellow);
    padding: 30px 34px;
  }
  .founder__mission p {
    font-family: var(--f-head);
    font-size: 21px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--c-dark);
  }

  /* vision / mission */
  .vm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 16px;
  }
  .vm-card {
    position: relative;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--c-line);
    padding: clamp(26px, 3.6vw, 48px);
  }
  .vm-card__blob {
    position: absolute;
    right: -50px;
    top: -50px;
    width: 180px;
    height: 180px;
    border-radius: 999px;
  }
  .vm-card__blob--green { background: #F3F7F0; }
  .vm-card__blob--red { background: #FDF3E9; }
  .vm-card__inner { position: relative; }
  .vm-card__icon {
    display: flex;
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    margin-bottom: 26px;
  }
  .vm-card__icon--green { background: var(--c-green); }
  .vm-card__icon--red { background: var(--c-red); }
  .vm-card h3 {
    margin: 0 0 16px;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--c-dark);
  }
  .vm-card p {
    font-size: 17px;
    line-height: 1.66;
    color: var(--c-muted);
  }

  /* team */
  .team {
    position: relative;
    overflow: hidden;
    background: var(--c-dark);
    padding: clamp(30px, 4.6vw, 64px) 0;
  }
  .team__bg { position: absolute; inset: 0; }
  .team__img {
    position: absolute;
    right: 0;
    top: 0;
    width: 32%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
  }
  .team__inner { position: relative; }
  .team__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 60px;
    flex-wrap: wrap;
    margin-bottom: 44px;
  }
  .team__head h2 {
    font-size: clamp(24px, 3.2vw, 42px);
    color: #fff;
  }
  .team__head p {
    max-width: 380px;
    font-size: 16.5px;
    line-height: 1.62;
    color: var(--on-dark-mute-2);
  }
  .team__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.16);
  }
  @media (max-width: 1024px) {
    .team__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .team__grid { grid-template-columns: 1fr; }
  }
  .team__tile {
    background: var(--c-dark);
    padding: 32px 30px;
  }
  .team__value {
    font-family: var(--f-head);
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--c-yellow);
    line-height: 1;
  }
  .team__tile h3 {
    margin: 16px 0 8px;
    font-size: 19px;
    font-weight: 700;
    color: #fff;
  }
  .team__tile p {
    font-size: 15px;
    line-height: 1.6;
    color: #9EAB9F;
  }

  /* how we work */
  .hww__title {
    margin: 0 0 40px;
    font-size: clamp(24px, 3.2vw, 42px);
    color: var(--c-dark);
  }
  .hww__grid {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 1024px) {
    .hww__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .hww__grid { grid-template-columns: 1fr; }
  }
  .hww__cell {
    background: #fff;
    padding: 36px 32px;
  }
  .hww__icon {
    display: flex;
    width: 50px;
    height: 50px;
    background: var(--c-tint);
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
  }
  .hww__cell h3 {
    margin: 0 0 10px;
    font-size: 20px;
    font-weight: 700;
    color: var(--c-dark);
  }
  .hww__cell p {
    font-size: 15.5px;
    line-height: 1.62;
    color: var(--c-muted-2);
  }
</style>

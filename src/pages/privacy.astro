---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { getSite } from '../lib/keystatic.ts';

const site = await getSite();
const email = site.contact.email;
const domain = site.footer.domain;

// Keep this in step with the page: bump it whenever the policy changes.
const lastUpdated = '31 August 2026';

const title = 'Privacy Policy — Mandrex VA Services';
const description =
  'How Mandrex VA Services collects, uses and protects the personal information you share through this website.';
---
<Layout title={title} description={description}>
  <section class="container legal">
    <div class="legal__head">
      <div class="eyebrow">
        <span class="eyebrow__rule"></span>
        <span class="eyebrow__label">Legal</span>
      </div>
      <h1 class="legal__title">Privacy Policy</h1>
      <p class="legal__meta">Last updated {lastUpdated}</p>
    </div>

    <div class="legal__body">
      <p class="legal__lead">
        This policy explains what personal information Mandrex VA Services collects through
        this website, why we collect it, and what we do with it. It covers this website only —
        not the client engagements we carry out, which are governed by the agreement in place
        with each client.
      </p>

      <h2>Who we are</h2>
      <p>
        Mandrex VA Services provides virtual assistance, bookkeeping, administrative and
        customer support services. For anything relating to this policy or to your personal
        information, contact us at <a href={`mailto:${email}`}>{email}</a>.
      </p>

      <h2>What we collect</h2>
      <p><strong>Information you give us.</strong> This website has two forms, and both are optional to use.</p>
      <ul>
        <li>
          The <strong>contact form</strong> collects your name, email address, company, phone
          number, the type of support you are interested in, and your message.
        </li>
        <li>
          The <strong>call request form</strong> collects your name, email address, company,
          phone number, your preferred day and time, your time zone, the topic you would like
          to discuss, and any notes you add.
        </li>
      </ul>
      <p>
        Your time zone is pre-filled from your browser's own setting purely as a convenience.
        You can change or clear it before submitting.
      </p>
      <p>
        <strong>Technical information.</strong> Like any website, ours is served by a hosting
        provider that records standard request data — including IP address, browser type and
        the pages requested — in its server logs. We use this only to keep the site running
        securely and reliably.
      </p>

      <h2>How we use it</h2>
      <p>
        We use the information you submit to reply to your enquiry, to arrange and confirm a
        call, and to provide the services you ask about. We do not sell your information, and
        we do not use it for advertising.
      </p>
      <p>
        If you are in the UK or the European Economic Area, our lawful basis for handling this
        information is our legitimate interest in responding to enquiries about our services,
        and where relevant, taking steps at your request before entering into a contract.
      </p>

      <h2>Who we share it with</h2>
      <p>
        We do not share your information with anyone except the service providers that make
        this website work:
      </p>
      <ul>
        <li>
          <strong>Web3Forms</strong> processes form submissions and delivers them to us by
          email. Your submission passes through their systems for that purpose.
        </li>
        <li>
          <strong>Cloudflare</strong> hosts and serves this website, and processes the
          technical request data described above.
        </li>
        <li>
          <strong>Google Fonts</strong> serves the typefaces used on this site. Because the
          fonts load from Google's servers, your IP address is visible to Google when a page
          loads.
        </li>
        <li>
          <strong>Google Analytics</strong> helps us understand how visitors use this website,
          such as which pages are viewed and how visitors found us. Google processes your IP
          address and browsing activity on this site for that purpose.
        </li>
      </ul>
      <p>
        We may also disclose information where we are required to do so by law.
      </p>

      <h2>International transfers</h2>
      <p>
        We support clients in the United States, Canada, the United Kingdom and Australia, and
        our team and the providers above operate across several countries. Your information may
        therefore be processed outside the country you live in.
      </p>

      <h2>How long we keep it</h2>
      <p>
        We keep enquiry and call-request correspondence for as long as needed to deal with your
        enquiry and to maintain a record of our dealings with you. If you would like us to
        delete your details, email us and we will do so, unless we are required to keep them.
      </p>

      <h2>Cookies</h2>
      <p>
        This website uses Google Analytics, which sets cookies to distinguish visitors and
        measure how the site is used. We do not run any advertising or ad-retargeting scripts.
        You can opt out of Google Analytics tracking using
        <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">
          Google's browser add-on
        </a>, or by blocking cookies in your browser settings.
      </p>

      <h2>Your rights</h2>
      <p>
        Depending on where you live, you may have the right to ask us for a copy of the
        personal information we hold about you, to have it corrected or deleted, to object to
        or restrict how we use it, and to receive it in a portable form. To exercise any of
        these, email <a href={`mailto:${email}`}>{email}</a>.
      </p>
      <p>
        If you are in the UK or the EEA and you are unhappy with how we have handled your
        information, you also have the right to complain to your data protection authority.
      </p>

      <h2>Changes to this policy</h2>
      <p>
        If we change this policy we will update the date at the top of this page. Please check
        back from time to time.
      </p>

      <h2>Contact us</h2>
      <p>
        Questions about this policy, or about your information, can be sent to
        <a href={`mailto:${email}`}>{email}</a> or through the
        <a href="/contact">contact page</a> at {domain}.
      </p>
    </div>
  </section>
</Layout>

<style>
  .legal { padding: 90px var(--pad) 110px; }
  .legal__head { margin-bottom: 44px; }
  .legal__title {
    margin: 0 0 14px;
    font-size: clamp(30px, 5vw, 58px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--c-dark);
    text-transform: uppercase;
  }
  .legal__meta {
    margin: 0;
    font-family: var(--f-head);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--c-muted-3);
  }

  /* a measure narrow enough to stay readable at this length */
  .legal__body { max-width: 68ch; }
  .legal__lead {
    margin: 0 0 40px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--c-text);
  }
  .legal__body h2 {
    margin: 40px 0 14px;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--c-dark);
  }
  .legal__body p {
    margin: 0 0 16px;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--c-muted);
  }
  .legal__body ul {
    margin: 0 0 16px;
    padding-left: 20px;
  }
  .legal__body li {
    margin-bottom: 10px;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--c-muted);
  }
  .legal__body strong { color: var(--c-text); }
  .legal__body a {
    color: var(--c-green);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal__body a:hover { color: var(--c-red); }
</style>
